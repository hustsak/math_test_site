# Copy this file to .env.local and fill in the values.

# --- Firebase web app config (Project settings > General > Your apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The ONE email address allowed to use the admin dashboard.
# Must match the email in firestore.rules.
NEXT_PUBLIC_ADMIN_EMAIL=teacher@example.com

# --- Firebase Admin (Project settings > Service accounts > Generate new private key) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n sequences exactly as in the downloaded JSON.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- AI features (question generation, Khmer explanations). Optional: leave empty to disable. ---
# Get a key at https://console.anthropic.com. It stays on the server and is never sent to browsers.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL=
