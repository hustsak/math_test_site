rules_version = '2';

// Students and parents never touch Firestore directly. They use the server API routes,
// which run with the Admin SDK (bypassing these rules) and never reveal answers.
// Only the teacher's account can read or write from the browser.
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null;
    }

    match /exercises/{id} {
      allow read, write: if isTeacher();
    }

    match /submissions/{id} {
      allow read, delete: if isTeacher();
      allow create, update: if false;
    }

    match /profiles/{id} {
      allow read, write: if isTeacher();
    }

    // Student Access Control: only the authenticated teacher can read or write student access records directly.
    // Students and parents must NEVER read or modify student records directly from the browser;
    // all student authorization is enforced server-side using the Firebase Admin SDK.
    match /students/{id} {
      allow read, write: if isTeacher();
    }

    match /settings/{id} {
      allow read, write: if isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
