rules_version = '2';

// Students never touch Firestore directly. They use the server API routes,
// which run with the Admin SDK (bypassing these rules) and never reveal answers.
// Only the teacher's account can read or write from the browser.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'viraksakkoy8@gmail.com'; // <-- CHANGE THIS
    }

    match /exercises/{id} {
      allow read, write: if isAdmin();
    }

    match /submissions/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }
  }
}
