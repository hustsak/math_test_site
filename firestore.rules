rules_version = '2';

// Students never touch Firestore directly. They use the server API routes,
// which run with the Admin SDK (bypassing these rules) and never reveal answers.
// Only the teacher's account can read or write from the browser.
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null;
    }

    match /exercises/{id} {
      allow read, write: if isTeacher();
    }

    match /submissions/{id} {
      allow read, delete: if isTeacher();
      allow create, update: if false;
    }
  }
}
