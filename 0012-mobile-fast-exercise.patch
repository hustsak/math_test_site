+}
+const fontFile = new URL('../public/fonts/siemreap-400.woff2', import.meta.url);
+assert.ok(statSync(fontFile).size > 10_000, 'the Siemreap font file is in public/fonts');
+assert.ok(statSync(new URL('../public/fonts/OFL.txt', import.meta.url)).size > 500, 'the font license ships with it');
+assert.match(css, /@font-face\s*\{[^}]*font-family:\s*'Siemreap'[^}]*url\('\/fonts\/siemreap-400\.woff2'\)[^}]*font-display:\s*swap|@font-face\s*\{[^}]*font-display:\s*swap[^}]*url\('\/fonts\/siemreap-400\.woff2'\)/s, '@font-face points at /fonts');
+assert.match(layout, /rel="preload"[\s\S]*?href="\/fonts\/siemreap-400\.woff2"[\s\S]*?as="font"/, 'the font is preloaded');
 for (const old of ['Inter', 'Kantumruy', 'Noto+Sans+Khmer']) {
   assert.ok(!layout.includes(old), `layout no longer loads ${old}`);
 }
diff --git a/scripts/test-watermark.mjs b/scripts/test-watermark.mjs
new file mode 100644
index 0000000..b008098
--- /dev/null
+++ b/scripts/test-watermark.mjs
@@ -0,0 +1,42 @@
+// The watermark is one repeating SVG tile with the student's name (npm run test:watermark).
+// Needs Node 22.18+ (imports the TypeScript source directly).
+import assert from 'node:assert/strict';
+import { cpSync, mkdtempSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const tmp = mkdtempSync(join(tmpdir(), 'watermark-test-'));
+cpSync(new URL('../src/lib/watermark.ts', import.meta.url), join(tmp, 'watermark.ts'));
+const { watermarkBackground, escapeXml } = await import(pathToFileURL(join(tmp, 'watermark.ts')).href);
+
+const decode = (css) => {
+  const m = css.match(/^url\("data:image\/svg\+xml,(.*)"\)$/);
+  assert.ok(m, 'is a CSS url("data:image/svg+xml,...") value');
+  return decodeURIComponent(m[1]);
+};
+
+// Khmer name + date, as shown on a real screenshot
+const khmer = 'សុខ ដារា · 10/31/2026 09:41';
+const svg = decode(watermarkBackground(khmer));
+assert.ok(svg.startsWith('<svg xmlns="http://www.w3.org/2000/svg"'), 'valid SVG');
+assert.ok(svg.includes(khmer), 'the name and time are in the tile');
+assert.ok(svg.endsWith('</svg>'));
+
+// Tile is sized for the text, never tiny or huge
+const [, w, h] = svg.match(/width="(\d+)" height="(\d+)"/).map(Number);
+assert.ok(w > 150 && w < 700 && h > 100 && h < 500, `tile ${w}x${h} is a sensible size`);
+
+// A name can never break out of the SVG (XML injection)
+assert.equal(escapeXml('<a href="x">&\'</a>'), '&lt;a href=&quot;x&quot;&gt;&amp;&apos;&lt;/a&gt;');
+const evil = decode(watermarkBackground('"><script>alert(1)</script>'));
+assert.ok(!evil.includes('<script>'), 'markup in a name is escaped');
+assert.ok(evil.includes('&lt;script&gt;'));
+// ...and it can never close the CSS url("...") either
+assert.ok(!watermarkBackground('x") ; background: red; ("').slice(0, -2).includes('")'));
+
+// Very long names are cut so the tile stays small
+assert.ok(decode(watermarkBackground('x'.repeat(500))).length < 1500);
+assert.doesNotThrow(() => watermarkBackground(undefined));
+
+console.log('Watermark checks passed: one tile, name and time inside, markup-safe.');
diff --git a/src/app/api/public/grade-codes/route.ts b/src/app/api/public/grade-codes/route.ts
new file mode 100644
index 0000000..0ac7315
--- /dev/null
+++ b/src/app/api/public/grade-codes/route.ts
@@ -0,0 +1,25 @@
+import { NextResponse } from 'next/server';
+import { adminDb } from '@/lib/firebaseAdmin';
+
+// Always read fresh from the server (then cached briefly by the CDN, see below)
+export const dynamic = 'force-dynamic';
+
+/**
+ * Public and tiny: the class names and their grade numbers (e.g. { "វិញ្ញាសាពេទ្យ": 30 }), so
+ * the student pages can show a class name without loading the whole Firestore client library.
+ * This is the same information the public registration page already shows.
+ */
+export async function GET() {
+  let gradeCodes: Record<string, number> = {};
+  try {
+    const snap = await adminDb().collection('settings').doc('app').get();
+    const codes = snap.exists ? snap.data()?.gradeCodes : null;
+    if (codes && typeof codes === 'object') gradeCodes = codes as Record<string, number>;
+  } catch {
+    // fall through with no names: the pages then show "ថ្នាក់ទី 7" style labels
+  }
+  return NextResponse.json(
+    { gradeCodes },
+    { headers: { 'Cache-Control': 'public, s-maxage=60, stale-while-revalidate=86400' } }
+  );
+}
