     <>
       {/* Repeating watermark with the student's name */}
       <div className="sg-watermark" aria-hidden="true">
-        {Array.from({ length: 40 }).map((_, i) => (
+        {Array.from({ length: 260 }).map((_, i) => (
           <span key={i}>{mark}</span>
         ))}
       </div>
